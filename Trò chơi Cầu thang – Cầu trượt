      if (sounds.enabled) {
        iconSoundOn.classList.remove('hidden');
        iconSoundOff.classList.add('hidden');
      } else {
        iconSoundOn.classList.add('hidden');
        iconSoundOff.classList.remove('hidden');
      }
    });

    btnRules.addEventListener('click', () => modalRules.classList.remove('hidden'));
    btnCloseRules.addEventListener('click', () => modalRules.classList.add('hidden'));
    btnGotRules.addEventListener('click', () => modalRules.classList.add('hidden'));

    btnEmbed.addEventListener('click', () => modalEmbed.classList.remove('hidden'));
    btnCloseEmbed.addEventListener('click', () => modalEmbed.classList.add('hidden'));

    btnCopyIframe.addEventListener('click', () => {
      const code = document.getElementById('embed-iframe-code').value;
      copyTextToClipboard(code, () => {
        embedToast.textContent = 'Đã sao chép mã Iframe vào bộ nhớ tạm!';
        embedToast.classList.remove('hidden');
        setTimeout(() => embedToast.classList.add('hidden'), 2000);
      });
    });

    btnCopyFullHtml.addEventListener('click', () => {
      const fullHtml = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
      copyTextToClipboard(fullHtml, () => {
        embedToast.textContent = 'Đã sao chép toàn bộ mã nguồn HTML!';
        embedToast.classList.remove('hidden');
        setTimeout(() => embedToast.classList.add('hidden'), 2000);
      });
    });

    btnDownloadHtml.addEventListener('click', () => {
      const fullHtml = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
      const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'cau-thang-cau-truot.html';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    btnClearLog.addEventListener('click', () => {
      gameLogEl.innerHTML = '<div class="text-slate-400 italic">Nhật ký đã được xóa.</div>';
    });

    window.addEventListener('load', () => {
      initGame();
    });
