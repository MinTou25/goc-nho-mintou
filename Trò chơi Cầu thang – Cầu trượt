      { id: 1, name: 'Mèo Vàng 🐱', isBot: false, color: '#eab308', bg: 'bg-amber-500', text: 'text-amber-600', ring: 'ring-amber-400', border: 'border-amber-500' },
      { id: 2, name: 'Ếch Xanh 🐸', isBot: false, color: '#22c55e', bg: 'bg-emerald-500', text: 'text-emerald-600', ring: 'ring-emerald-400', border: 'border-emerald-500' },
      { id: 3, name: 'Gấu Nâu 🐻', isBot: false, color: '#a855f7', bg: 'bg-purple-500', text: 'text-purple-600', ring: 'ring-purple-400', border: 'border-purple-500' }
    ];

    /* Game State */
    let activePlayers = [];
    let currentPlayerIndex = 0;
    let isRolling = false;
    let pendingTurn = null; // { player, fromPos, toPos, diceVal, cell }

    /* ==========================================================================
       3. DOM ELEMENTS
       ========================================================================== */
    const boardEl = document.getElementById('board');
    const btnRoll = document.getElementById('btn-roll');
    const diceEl = document.getElementById('dice');
    const diceFaceEl = document.getElementById('dice-face');
    const statusBoxEl = document.getElementById('status-box');
    const turnBadgeEl = document.getElementById('turn-badge');
    const turnPlayerNameEl = document.getElementById('turn-player-name');
    const playersListEl = document.getElementById('players-list');
    const selectModeEl = document.getElementById('select-mode');
    const gameLogEl = document.getElementById('game-log');
    const btnClearLog = document.getElementById('btn-clear-log');
    const btnSound = document.getElementById('btn-sound');
    const iconSoundOn = document.getElementById('icon-sound-on');
    const iconSoundOff = document.getElementById('icon-sound-off');
    const btnRules = document.getElementById('btn-rules');
    const btnEmbed = document.getElementById('btn-embed');
    const btnReset = document.getElementById('btn-reset');

    // Modals
    const modalQuestion = document.getElementById('modal-question');
    const modalPlayerName = document.getElementById('modal-player-name');
    const btnChoiceA = document.getElementById('btn-choice-a');
    const btnChoiceB = document.getElementById('btn-choice-b');
    const textChoiceA = document.getElementById('text-choice-a');
    const textChoiceB = document.getElementById('text-choice-b');
    const modalFeedback = document.getElementById('modal-feedback');
    const feedbackIcon = document.getElementById('feedback-icon');
    const feedbackTitle = document.getElementById('feedback-title');
    const feedbackText = document.getElementById('feedback-text');
    const btnConfirmNext = document.getElementById('btn-confirm-next');

    const modalRules = document.getElementById('modal-rules');
    const btnCloseRules = document.getElementById('btn-close-rules');
    const btnGotRules = document.getElementById('btn-got-rules');

    const modalEmbed = document.getElementById('modal-embed');
    const btnCloseEmbed = document.getElementById('btn-close-embed');
    const btnCopyIframe = document.getElementById('btn-copy-iframe');
    const btnDownloadHtml = document.getElementById('btn-download-html');
    const btnCopyFullHtml = document.getElementById('btn-copy-full-html');
    const embedToast = document.getElementById('embed-toast');

    const modalVictory = document.getElementById('modal-victory');
    const victoryPlayerName = document.getElementById('victory-player-name');
    const btnVictoryRestart = document.getElementById('btn-victory-restart');

    /* ==========================================================================
       4. BOARD RENDERING
       ========================================================================== */
    function renderBoard() {
      const overlay = document.getElementById('board-overlay');
      boardEl.innerHTML = '';
      boardEl.appendChild(overlay);

      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 5; c++) {
          const cellIndex = PATH_CELLS.findIndex(item => item.r === r && item.c === c);
          const cellData = PATH_CELLS[cellIndex];
          
          const cellEl = document.createElement('div');
          cellEl.id = `cell-${cellIndex}`;
          cellEl.className = 'board-cell p-1.5 text-center relative';
          cellEl.dataset.index = cellIndex;

          if (cellData.type === 'start') {
            cellEl.innerHTML = `
              <div class="flex flex-col items-center justify-center h-full">
                <span class="font-heading font-black text-xs sm:text-sm text-red-600 tracking-wider">XUẤT</span>
                <span class="font-heading font-black text-xs sm:text-sm text-red-600 tracking-wider">PHÁT</span>
                <span class="text-red-500 text-sm font-black leading-none mt-0.5">⬅</span>
              </div>
            `;
          } else if (cellData.type === 'finish') {
            cellEl.innerHTML = `
              <div class="flex flex-col items-center justify-center h-full bg-amber-100/80 rounded-lg w-full">
                <span class="text-xl">🏁</span>
                <span class="font-heading font-black text-sm sm:text-base text-red-600 tracking-widest">ĐÍCH</span>
              </div>
            `;
          } else if (cellData.type === 'flower') {
            cellEl.innerHTML = `
              <div class="flex flex-col items-center justify-center h-full">
                <svg class="w-10 h-10 sm:w-12 sm:h-12 drop-shadow-sm transition transform hover:scale-110" viewBox="0 0 100 100">
                  <g fill="#e9d5ff" stroke="#c084fc" stroke-width="2">
                    <circle cx="50" cy="20" r="15" />
                    <circle cx="78" cy="38" r="15" />
                    <circle cx="70" cy="72" r="15" />
                    <circle cx="30" cy="72" r="15" />
                    <circle cx="22" cy="38" r="15" />
                  </g>
                  <path d="M 20,70 Q 10,85 25,85 Q 35,80 20,70" fill="#86efac" stroke="#22c55e" stroke-width="2"/>
                  <circle cx="50" cy="50" r="22" fill="#fef08a" stroke="#facc15" stroke-width="3"/>
                  <circle cx="43" cy="45" r="2.5" fill="#475569"/>
                  <circle cx="57" cy="45" r="2.5" fill="#475569"/>
                  <circle cx="39" cy="52" r="3" fill="#fca5a5" opacity="0.6"/>
                  <circle cx="61" cy="52" r="3" fill="#fca5a5" opacity="0.6"/>
                  <path d="M 43,53 Q 50,60 57,53" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span class="text-[10px] font-extrabold text-purple-700 mt-0.5">Vượt qua</span>
              </div>
            `;
          } else if (cellData.type === 'math') {
            cellEl.innerHTML = `
              <div class="flex flex-col items-center justify-center h-full gap-0.5">
                <span class="font-heading font-black text-xs sm:text-sm text-slate-800 tracking-tight">${cellData.nums[0]}</span>
                <span class="font-heading font-black text-xs sm:text-sm text-slate-800 tracking-tight">${cellData.nums[1]}</span>
              </div>
            `;
          }

          const tokensContainer = document.createElement('div');
          tokensContainer.className = 'tokens-holder absolute bottom-1 left-0 right-0 flex items-center justify-center gap-1 z-20 pointer-events-none px-1 flex-wrap';
          tokensContainer.id = `tokens-cell-${cellIndex}`;
          cellEl.appendChild(tokensContainer);

          boardEl.appendChild(cellEl);
        }
      }
    }

    /* Update Player Tokens on Board */
    function updateTokensOnBoard() {
      for (let i = 0; i < PATH_CELLS.length; i++) {
        const holder = document.getElementById(`tokens-cell-${i}`);
        if (holder) holder.innerHTML = '';
      }

      activePlayers.forEach((player) => {
        const holder = document.getElementById(`tokens-cell-${player.pos}`);
        if (holder) {
          const token = document.createElement('div');
          token.className = `token w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center text-xs shadow-md border-2 border-white ring-2 ${player.ring} ${player.bg} text-white font-extrabold select-none transition-all duration-300`;
          token.title = `${player.name} (Ô ${player.pos})`;
          token.innerHTML = player.name.slice(-2);
          holder.appendChild(token);
        }
      });
    }

    /* Update Player Cards in Sidebar */
    function updatePlayerCards() {
      playersListEl.innerHTML = '';
      activePlayers.forEach((player, idx) => {
        const isCurrent = idx === currentPlayerIndex;
        const card = document.createElement('div');
        card.className = `p-2.5 rounded-xl border transition flex items-center justify-between ${
          isCurrent 
            ? 'bg-orange-50/90 border-orange-400 shadow-sm ring-1 ring-orange-300' 
            : 'bg-slate-50/70 border-slate-200'
        }`;

        card.innerHTML = `
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full ${player.bg} text-white flex items-center justify-center text-sm font-bold shadow-sm">
              ${player.name.slice(-2)}
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="font-heading font-extrabold text-xs ${isCurrent ? 'text-orange-950 font-black' : 'text-slate-800'}">${player.name}</span>
                ${player.isBot ? '<span class="px-1.5 py-0.2 bg-slate-200 text-slate-600 rounded text-[9px] font-bold">MÁY</span>' : ''}
              </div>
              <span class="text-[11px] text-slate-500 font-medium">Đang ở: <strong>${getCellDescription(player.pos)}</strong></span>
            </div>
          </div>
          ${isCurrent ? '<span class="text-[11px] font-extrabold text-orange-600 bg-orange-100 px-2 py-0.5 rounded-full">Đang đi</span>' : ''}
        `;
        playersListEl.appendChild(card);
      });

      const current = activePlayers[currentPlayerIndex];
      if (current) {
        turnPlayerNameEl.textContent = current.name;
        turnBadgeEl.className = `px-2.5 py-0.5 rounded-full text-xs font-extrabold flex items-center gap-1.5 text-white ${current.bg}`;
      }
    }

    function getCellDescription(pos) {
      if (pos === 0) return 'Xuất phát';
      if (pos === 19) return 'Đích 🏁';
      const cell = PATH_CELLS[pos];
      if (cell.type === 'flower') return 'Bông hoa 🌸';
      return `Ô [${cell.nums.join(' / ')}]`;
    }

    function logEvent(htmlText) {
      const entry = document.createElement('div');
      entry.className = 'py-1 border-b border-slate-100 last:border-none leading-relaxed';
      entry.innerHTML = htmlText;
      gameLogEl.appendChild(entry);
      gameLogEl.scrollTop = gameLogEl.scrollHeight;
    }

    /* ==========================================================================
       5. DICE LOGIC & 3D RENDERING
       ========================================================================== */
    const DICE_PIPS = {
      1: [4],
      2: [0, 8],
      3: [0, 4, 8],
      4: [0, 2, 6, 8],
      5: [0, 2, 4, 6, 8],
      6: [0, 2, 3, 5, 6, 8]
    };

    function renderDiceFace(value) {
      diceFaceEl.innerHTML = '';
      const activePips = DICE_PIPS[value] || [4];
      for (let i = 0; i < 9; i++) {
        const pip = document.createElement('div');
        if (activePips.includes(i)) {
          pip.className = value === 1 ? 'pip' : 'pip black';
        }
        diceFaceEl.appendChild(pip);
      }
    }

    function rollDiceAction() {
      if (isRolling) return;
      const player = activePlayers[currentPlayerIndex];
      if (!player) return;

      isRolling = true;
      btnRoll.disabled = true;
      btnRoll.classList.add('opacity-50', 'cursor-not-allowed');
      statusBoxEl.innerHTML = `<strong>${player.name}</strong> đang gieo xúc xắc...`;

      sounds.diceRoll();
      diceEl.classList.add('rolling');

      let rolls = 0;
      const interval = setInterval(() => {
        const rand = Math.floor(Math.random() * 6) + 1;
        renderDiceFace(rand);
        rolls++;
        if (rolls > 8) {
          clearInterval(interval);
          finalizeRoll();
        }
      }, 70);
    }

    function finalizeRoll() {
      diceEl.classList.remove('rolling');
      const diceValue = Math.floor(Math.random() * 6) + 1;
      renderDiceFace(diceValue);

      const player = activePlayers[currentPlayerIndex];
      const fromPos = player.pos;
      const targetPos = Math.min(fromPos + diceValue, 19);

      statusBoxEl.innerHTML = `<strong>${player.name}</strong> gieo được <strong>${diceValue}</strong> chấm! Đang di chuyển...`;
      logEvent(`🎲 <strong>${player.name}</strong> gieo được <strong>${diceValue} chấm</strong>.`);

      animatePlayerHops(player, fromPos, targetPos, () => {
        handleArrival(player, fromPos, targetPos, diceValue);
      });
    }

    function animatePlayerHops(player, current, target, onComplete) {
      if (current === target) {
        onComplete();
        return;
      }
      setTimeout(() => {
        player.pos++;
        sounds.hop();
        updateTokensOnBoard();
        animatePlayerHops(player, player.pos, target, onComplete);
      }, 250);
    }

    /* ==========================================================================
       6. HANDLING ARRIVAL AT CELL
       ========================================================================== */
    function handleArrival(player, fromPos, targetPos, diceValue) {
      const destCell = PATH_CELLS[targetPos];

      // Finish Line
      if (destCell.type === 'finish') {
        sounds.victory();
        logEvent(`🏆 <strong>${player.name}</strong> ĐÃ VỀ ĐÍCH CHIẾN THẮNG!`);
        statusBoxEl.innerHTML = `🎉 <strong>${player.name}</strong> đã về đích thành công!`;
        triggerVictory(player);
        return;
      }

      // Flower Cell
      if (destCell.type === 'flower') {
        sounds.correct();
        statusBoxEl.innerHTML = `🌸 <strong>${player.name}</strong> gặp Bông hoa may mắn! Tự vượt qua an toàn.`;
        logEvent(`🌸 <strong>${player.name}</strong> đến ô Bông hoa: Tự vượt qua an toàn.`);
        setTimeout(() => {
          advanceToNextTurn();
        }, 1200);
        return;
      }

      // Math Comparison Cell
      pendingTurn = {
        player,
        fromPos,
        toPos: targetPos,
        diceVal: diceValue,
        cell: destCell
      };

      if (player.isBot) {
        handleBotTurn(pendingTurn);
      } else {
        openQuestionModal(pendingTurn);
      }
    }

    /* ==========================================================================
       7. QUESTION MODAL & ANSWER VERIFICATION
       ========================================================================== */
    function openQuestionModal(turn) {
      modalPlayerName.textContent = turn.player.name;
      modalPlayerName.className = `font-bold ${turn.player.text}`;

      textChoiceA.textContent = turn.cell.nums[0];
      textChoiceB.textContent = turn.cell.nums[1];

      modalFeedback.classList.add('hidden');
      btnConfirmNext.classList.add('hidden');
      btnChoiceA.disabled = false;
      btnChoiceB.disabled = false;
      btnChoiceA.className = "p-4 bg-gradient-to-b from-white to-amber-50 hover:to-amber-100 active:scale-95 border-2 border-amber-300 hover:border-orange-500 rounded-2xl shadow-sm transition flex flex-col items-center justify-center gap-1 group";
      btnChoiceB.className = "p-4 bg-gradient-to-b from-white to-amber-50 hover:to-amber-100 active:scale-95 border-2 border-amber-300 hover:border-orange-500 rounded-2xl shadow-sm transition flex flex-col items-center justify-center gap-1 group";

      modalQuestion.classList.remove('hidden');
    }

    function checkAnswer(chosenNum) {
      btnChoiceA.disabled = true;
      btnChoiceB.disabled = true;

      const isCorrect = chosenNum === pendingTurn.cell.larger;
      const cell = pendingTurn.cell;
      const player = pendingTurn.player;

      modalFeedback.classList.remove('hidden');
      btnConfirmNext.classList.remove('hidden');

      if (isCorrect) {
        sounds.correct();
        modalFeedback.className = "w-full rounded-2xl p-3.5 text-xs font-medium bg-emerald-50 border border-emerald-200 text-emerald-900";
        feedbackIcon.textContent = "✅";
        feedbackTitle.textContent = "Chính xác! Em làm rất tốt!";
        feedbackTitle.className = "font-bold text-sm text-emerald-800 mb-0.5";
        feedbackText.innerHTML = `Số lớn hơn là <strong>${cell.larger}</strong>.<br><span class="text-emerald-700">${cell.expl}</span>`;

        logEvent(`✅ <strong>${player.name}</strong> đọc đúng số lớn hơn: <strong>${cell.larger}</strong>.`);
        pendingTurn.success = true;
      } else {
        sounds.wrong();
        modalFeedback.className = "w-full rounded-2xl p-3.5 text-xs font-medium bg-rose-50 border border-rose-200 text-rose-900";
        feedbackIcon.textContent = "❌";
        feedbackTitle.textContent = "Chưa chính xác!";
        feedbackTitle.className = "font-bold text-sm text-rose-800 mb-0.5";
        feedbackText.innerHTML = `Số lớn hơn là <strong>${cell.larger}</strong> (không phải ${chosenNum}).<br><span class="text-rose-700">${cell.expl}</span><br><strong class="text-rose-900 mt-1 block">Theo luật: Em phải quay về ô xuất phát trước đó!</strong>`;

        logEvent(`❌ <strong>${player.name}</strong> chọn ${chosenNum} (Sai). Phải quay về ô trước đó.`);
        pendingTurn.success = false;
      }
    }

    function handleConfirmNext() {
      modalQuestion.classList.add('hidden');
      const turn = pendingTurn;

      if (!turn.success) {
        statusBoxEl.innerHTML = `↩️ <strong>${turn.player.name}</strong> đọc sai, quay về ô trước đó!`;
        turn.player.pos = turn.fromPos;
        updateTokensOnBoard();
        updatePlayerCards();
        setTimeout(advanceToNextTurn, 900);
        return;
      }

      const currentCell = turn.cell;
      
      // Ladder Check
      if (currentCell.ladderTo !== undefined) {
        statusBoxEl.innerHTML = `🪜 <strong>${turn.player.name}</strong> đứng ở chân cầu thang! Được leo lên!`;
        logEvent(`🪜 <strong>${turn.player.name}</strong> leo cầu thang từ ô ${turn.toPos} lên ô ${currentCell.ladderTo}!`);
        sounds.climbLadder();
        
        setTimeout(() => {
          turn.player.pos = currentCell.ladderTo;
          updateTokensOnBoard();
          updatePlayerCards();
          setTimeout(advanceToNextTurn, 1000);
        }, 700);
        return;
      }

      // Slide Check
      if (currentCell.slideTo !== undefined) {
        statusBoxEl.innerHTML = `🛝 <strong>${turn.player.name}</strong> trúng đỉnh cầu trượt! Bị trượt xuống!`;
        logEvent(`🛝 <strong>${turn.player.name}</strong> trượt từ đỉnh cầu trượt ô ${turn.toPos} xuống ô ${currentCell.slideTo}!`);
        sounds.slideDown();

        setTimeout(() => {
          turn.player.pos = currentCell.slideTo;
          updateTokensOnBoard();
          updatePlayerCards();
          setTimeout(advanceToNextTurn, 1000);
        }, 700);
        return;
      }

      // Normal safe stay
      advanceToNextTurn();
    }

    /* Robot / Bot player automation */
    function handleBotTurn(turn) {
      statusBoxEl.innerHTML = `🤖 <strong>${turn.player.name}</strong> đang suy nghĩ và so sánh hai số...`;
      setTimeout(() => {
        const isCorrect = Math.random() < 0.90;
        const chosen = isCorrect ? turn.cell.larger : (turn.cell.nums[0] === turn.cell.larger ? turn.cell.nums[1] : turn.cell.nums[0]);
        
        if (isCorrect) {
          sounds.correct();
          logEvent(`🤖 <strong>${turn.player.name}</strong> đã chọn đúng số lớn hơn: <strong>${chosen}</strong>.`);
          
          if (turn.cell.ladderTo !== undefined) {
            statusBoxEl.innerHTML = `🪜 <strong>${turn.player.name}</strong> leo lên cầu thang!`;
            logEvent(`🪜 <strong>${turn.player.name}</strong> leo cầu thang lên ô ${turn.cell.ladderTo}!`);
            sounds.climbLadder();
            setTimeout(() => {
              turn.player.pos = turn.cell.ladderTo;
              updateTokensOnBoard();
              updatePlayerCards();
              setTimeout(advanceToNextTurn, 900);
            }, 600);
          } else if (turn.cell.slideTo !== undefined) {
            statusBoxEl.innerHTML = `🛝 <strong>${turn.player.name}</strong> bị trượt xuống đáy cầu trượt!`;
            logEvent(`🛝 <strong>${turn.player.name}</strong> bị trượt xuống ô ${turn.cell.slideTo}!`);
            sounds.slideDown();
            setTimeout(() => {
              turn.player.pos = turn.cell.slideTo;
              updateTokensOnBoard();
              updatePlayerCards();
              setTimeout(advanceToNextTurn, 900);
            }, 600);
          } else {
            advanceToNextTurn();
          }
        } else {
          sounds.wrong();
          logEvent(`🤖 <strong>${turn.player.name}</strong> chọn ${chosen} (Sai). Quay về ô xuất phát trước đó.`);
          turn.player.pos = turn.fromPos;
          updateTokensOnBoard();
          updatePlayerCards();
          setTimeout(advanceToNextTurn, 1000);
        }
      }, 1000);
    }

    /* ==========================================================================
       8. TURN ADVANCEMENT & VICTORY
       ========================================================================== */
    function advanceToNextTurn() {
      currentPlayerIndex = (currentPlayerIndex + 1) % activePlayers.length;
      updatePlayerCards();

      const nextPlayer = activePlayers[currentPlayerIndex];
      isRolling = false;
      btnRoll.disabled = false;
      btnRoll.classList.remove('opacity-50', 'cursor-not-allowed');

      statusBoxEl.innerHTML = `Đến lượt <strong>${nextPlayer.name}</strong>! Hãy gieo xúc xắc.`;

      if (nextPlayer.isBot) {
        setTimeout(() => {
          if (!isRolling) rollDiceAction();
        }, 900);
      }
    }

    function triggerVictory(winner) {
      victoryPlayerName.textContent = winner.name;
      modalVictory.classList.remove('hidden');

      if (window.confetti) {
        confetti({
          particleCount: 120,
          spread: 80,
          origin: { y: 0.6 }
        });
      }
    }

    /* Helper: Copy to Clipboard with fallback */
    function copyTextToClipboard(text, onSuccess) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => {
          if (onSuccess) onSuccess();
        }).catch(() => {
          fallbackCopyText(text, onSuccess);
        });
      } else {
        fallbackCopyText(text, onSuccess);
      }
    }

    function fallbackCopyText(text, onSuccess) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
        if (onSuccess) onSuccess();
      } catch (e) {}
      document.body.removeChild(ta);
    }

    /* ==========================================================================
       9. INITIALIZATION & GAME RESET
       ========================================================================== */
    function initGame() {
      const mode = parseInt(selectModeEl.value, 10);
      activePlayers = [];

      if (mode === 1) {
        activePlayers.push({ ...ALL_PLAYERS[0], name: 'Em (Thỏ Hồng) 🐰', isBot: false, pos: 0 });
        activePlayers.push({ ...ALL_PLAYERS[1], name: 'Robot Toán Học 🤖', isBot: true, pos: 0 });
      } else {
        for (let i = 0; i < mode; i++) {
          activePlayers.push({ ...ALL_PLAYERS[i], isBot: false, pos: 0 });
        }
      }

      currentPlayerIndex = 0;
      isRolling = false;
      btnRoll.disabled = false;
      btnRoll.classList.remove('opacity-50', 'cursor-not-allowed');

      renderBoard();
      updateTokensOnBoard();
      updatePlayerCards();
      renderDiceFace(1);

      statusBoxEl.innerHTML = `Trò chơi mới bắt đầu! Lượt đầu tiên: <strong>${activePlayers[0].name}</strong>.`;
      logEvent(`🏁 <strong>Ván mới bắt đầu</strong> (${activePlayers.length} người chơi). Tất cả ở ô XUẤT PHÁT.`);
    }

    /* ==========================================================================
       10. EVENT LISTENERS
       ========================================================================== */
    btnRoll.addEventListener('click', rollDiceAction);
    diceEl.addEventListener('click', rollDiceAction);

    window.addEventListener('keydown', (e) => {
      const isAnyModalOpen = !modalQuestion.classList.contains('hidden') ||
                             !modalRules.classList.contains('hidden') ||
                             !modalEmbed.classList.contains('hidden') ||
                             !modalVictory.classList.contains('hidden');
      if (e.code === 'Space' && !isAnyModalOpen && !isRolling) {
        e.preventDefault();
        rollDiceAction();
      }
    });

